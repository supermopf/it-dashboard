{
  "name": "it-dashboard-monitor",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "description": "Signage-Frontend (Monitor) des IT-Dashboards – Vanilla TypeScript, gebaut mit Vite",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build && vite build --mode vendor && vite build --mode probe",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "analyze": "node scripts/bundle-report.mjs",
    "mock": "node tests/mock-server/server.mjs",
    "check": "npm run lint && npm run typecheck && npm run test && npm run build && npm run analyze && npm run test:php && npm run test:e2e",
    "test:php": "php ../tests/php/run.php && node tests/integration/server-php.mjs",
    "measure": "node scripts/measure.mjs",
    "fixtures": "node tests/fixtures/generate.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/ws": "^8.18.2",
    "eslint": "^10.13.0",
    "jsdom": "^30.1.3",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.5",
    "vitest": "^5.0.5",
    "ws": "^8.22.0"
  },
  "engines": {
    "node": ">=20.19"
  }
}
